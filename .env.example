# Neon connection string. In production set it with `npx wrangler secret put DATABASE_URL`.
DATABASE_URL=
# Protects /api/cron/* routes (worker.ts sends it as a Bearer token on cron runs).
CRON_SECRET=
APP_URL=https://metrics.silverbackweb.com
AUTH_SECRET=change-me
# Key used to encrypt per-client credentials at rest
ENCRYPTION_KEY=change-me-32-bytes
# Email alerts
RESEND_API_KEY=
# Phase 2+
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # Silverback MCC ID, no dashes
GOOGLE_SERVICE_ACCOUNT_JSON=    # GA4 + Search Console
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
